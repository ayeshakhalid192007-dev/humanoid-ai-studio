# =============================================================================
# Physical AI RAG Chatbot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# OpenAI Configuration
# =============================================================================


# Optional: Override default models
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=2000
# OPENAI_TEMPERATURE=0.3

# =============================================================================
# Qdrant Vector Database (Cloud)
# =============================================================================
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# Optional: Override defaults
# QDRANT_COLLECTION_NAME=curriculum
# QDRANT_SEARCH_LIMIT=5
# QDRANT_SCORE_THRESHOLD=0.7

# =============================================================================
# Neon Serverless Postgres
# =============================================================================
NEON_DATABASE_URL=postgresql://user:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: Connection pool settings
# NEON_POOL_MIN_SIZE=5
# NEON_POOL_MAX_SIZE=20
# NEON_COMMAND_TIMEOUT=10.0

# =============================================================================
# Better Auth (Session Authentication)
# =============================================================================
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_SECRET=your-better-auth-secret-here-generate-with-openssl-rand-hex-32

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_CORS_ORIGINS=http://localhost:3000,https://yourdomain.github.io

# Rate limiting (chat)
# RATE_LIMIT_MAX_QUERIES=20
# RATE_LIMIT_WINDOW_HOURS=1

# Rate limiting (AI generation - personalization & translation)
# PERSONALIZE_RATE_LIMIT_MAX=10
# TRANSLATE_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_WINDOW_HOURS=1

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development | staging | production
ENV=development

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to true to use mock services (no real API calls)
MOCK_MODE=false

# =============================================================================
# Deployment (Railway/Cloud)
# =============================================================================
# PORT=8000
