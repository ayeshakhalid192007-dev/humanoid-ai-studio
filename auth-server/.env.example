# =============================================================================
# auth-server/.env.example — copy to .env and fill in real values
# =============================================================================

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3002

# Redis (optional — in-memory fallback used if empty)
REDIS_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Frontend URL (used by OIDC provider login page redirect)
FRONTEND_URL=http://localhost:3000

# OIDC / PKCE book client (must match docusaurus.config.js customFields)
BOOK_CLIENT_ID=physical-ai-book
BOOK_REDIRECT_URIS=http://localhost:3000/auth/callback

# Google OAuth — register app at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3002/api/auth/callback/google (dev)
#                          https://<your-auth-server>/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth — register app at https://github.com/settings/developers → New OAuth App
# Authorization callback URL: http://localhost:3002/api/auth/callback/github (dev)
#                             https://<your-auth-server>/api/auth/callback/github (prod)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# App settings
PORT=3002
NODE_ENV=development
